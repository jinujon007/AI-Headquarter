# ─── Auth (required) ────────────────────────────────────────────────────────
ADMIN_PASSWORD=change-me-strong-password

# Generate AUTH_SECRET with:
#   node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
AUTH_SECRET=change-me-generate-with-the-command-above

# ─── LLM — Default: Ollama (local, free) ────────────────────────────────────
OLLAMA_URL=http://localhost:11434
OLLAMA_MODEL=llama3.2:3b

# Optional: dedicated embedding model for semantic memory search.
# Defaults to OLLAMA_MODEL if not set.
# Recommended: nomic-embed-text (pull with: ollama pull nomic-embed-text)
# OLLAMA_EMBEDDING_MODEL=nomic-embed-text

# ─── LLM — BYOK (optional) ──────────────────────────────────────────────────
# Add your keys in the dashboard Settings page — they are sent per-request
# and never stored on the server.
#
# OPENROUTER_API_KEY=sk-or-...   # supports Claude, GPT-4, Gemini, Llama
# OPENAI_API_KEY=sk-...
# GROQ_API_KEY=gsk_...
# GEMINI_API_KEY=...
# TAVILY_API_KEY=...              # optional: enables real web search (free tier available)

# ─── Server ─────────────────────────────────────────────────────────────────
PORT=3001
# Restrict CORS to this origin. Change if deploying dashboard on a different port/domain.
ALLOWED_ORIGIN=http://localhost:3000

# Optional: require this key on all mutating API endpoints (hire, CEO message).
# Leave unset for local dev (open mode). Set a strong random value for public deployments.
# Generate with: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
# AIHQ_SERVER_KEY=

# ─── Dashboard ──────────────────────────────────────────────────────────────
SERVER_URL=http://localhost:3001
NEXT_PUBLIC_SERVER_URL=http://localhost:3001
NEXT_PUBLIC_APP_TITLE=AI HQ
NEXT_PUBLIC_COMPANY_NAME=AI HEADQUARTERS
NEXT_PUBLIC_OWNER_USERNAME=your-github-username
