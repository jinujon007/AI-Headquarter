# ─── Auth (required) ────────────────────────────────────────────────────────
ADMIN_PASSWORD=change-me-strong-password

# Generate AUTH_SECRET with:
#   node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
AUTH_SECRET=change-me-generate-with-the-command-above

# ─── LLM — Default: Ollama (local, free) ────────────────────────────────────
OLLAMA_URL=http://localhost:11434
OLLAMA_MODEL=llama3.1:8b

# ─── LLM — BYOK (optional) ──────────────────────────────────────────────────
# Add your keys in the dashboard Settings page — they are sent per-request
# and never stored on the server.
#
# NOTE: "Claude (Anthropic)" in the dashboard currently routes through
# OpenRouter. Use an OpenRouter key with the "anthropic" provider selected.
# A native Anthropic adapter is on the v0.2.0 roadmap.
#
# OPENROUTER_API_KEY=sk-or-...   # supports Claude, GPT-4, Gemini, Llama
# OPENAI_API_KEY=sk-...
# GROQ_API_KEY=gsk_...
# GEMINI_API_KEY=...
# TAVILY_API_KEY=...              # optional: enables real web search (free tier available)

# ─── Server ─────────────────────────────────────────────────────────────────
PORT=3001
# Restrict CORS to this origin. Change if deploying dashboard on a different port/domain.
ALLOWED_ORIGIN=http://localhost:3000

# ─── Dashboard ──────────────────────────────────────────────────────────────
SERVER_URL=http://localhost:3001
NEXT_PUBLIC_SERVER_URL=http://localhost:3001
NEXT_PUBLIC_APP_TITLE=AI HQ
NEXT_PUBLIC_COMPANY_NAME=AI HEADQUARTERS
NEXT_PUBLIC_OWNER_USERNAME=your-github-username
